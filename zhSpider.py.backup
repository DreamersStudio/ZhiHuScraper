import requests
import json
import time
import random
import sqlite3
import jieba
from bs4 import BeautifulSoup
from datetime import datetime
import pandas as pd
import re
from urllib.parse import urljoin

class ZhihuSpider:
    def __init__(self):
        # 初始化基础配置
        self.base_url = "https://www.zhihu.com"
        self.headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
            'Accept-Language': 'zh-CN,zh;q=0.9,en;q=0.8',
            'Cookie': '_zap=a17c9b94-0793-4c2f-aa85-3197c4bee0a0; _xsrf=d4f7a18e-8613-47f0-9e88-7958a18ba5d5; HMACCOUNT=1A373AE255EED49D; d_c0=AhBSPfZy1hmPTm9aYTzr56HajePGuexe1Hs=|1736668163; __snaker__id=Agx3xdh2aCrBIgda; q_c1=4315ef35083344b285fc4936183f2b61|1736674536000|1736674536000; ff_supports_webp=1; Hm_lvt_98beee57fd2ef70ccdd5ca52b9740c49=1739263558; SESSIONID=638zR36X6kaeaLeuw859O4oKzAePnuMhCrhOfJraft8; JOID=W1wTBEKZ1Guet8vAZJfp9tpCtxtyouVS6uX19D2vsgj62IeoEyPqyPe6xMNrCd9OGBKpOIyV93nxIUQ6aGL_dUg=; osd=VVwcB0OX1GSdtsXAa5To-NpNtBp8oupR6-v1-z6uvAj124amEyzpyfm6y8BqB99BGxOnOIOW9nfxLkc7ZmLwdkk=; __zse_ck=004_qVEG1e32IcxLKruW6SY=IqU9eoUDaflpHbg9tnba2ALeT49Nqbgrj97/qve6B5F7Hcxo5YEyv=wupzQBdzsDncVUZRrvLsRAbaYtaLcUPRnjf5LicTzyhxB5/4GR/hel-7KYxwEJ9RUug5QTO39J5lV8eOdrWjnu4tXEkv38Bl+g5x1fcx5bbuGi64fnYARGmB/yDosMvzAW3J1tDanxDk/QLC/vmbwlsHhbZSj8rnoYZDI2LPTPAY6lKGB7tQ84/; Hm_lpvt_98beee57fd2ef70ccdd5ca52b9740c49=1739349017; BEC=8b4a1b0a664dd5d88434ef53342ae417; tst=r'  # 需要填入你的知乎Cookie
        }
        
        # 初始化数据库连接
        self.init_database()
        
        # 文章分类类别定义
        self.categories = {
            'tech': ['编程', '技术', '计算机', 'Python', '人工智能', '开发'],
            'finance': ['理财', '投资', '金融', '股票', '基金'],
            'career': ['职场', '工作', '面试', '求职', '创业'],
            'life': ['生活', '健康', '美食', '旅行', '情感'],
            'education': ['教育', '学习', '考试', '留学', '考研']
        }

    def init_database(self):
        """初始化数据库，创建必要的表结构"""
        self.conn = sqlite3.connect('zhihu_articles.db')
        cursor = self.conn.cursor()
        
        # 创建文章表
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS articles (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT NOT NULL,
            url TEXT UNIQUE NOT NULL,
            content TEXT NOT NULL,
            upvotes INTEGER NOT NULL,
            category TEXT NOT NULL,
            created_time DATETIME NOT NULL,
            collect_time DATETIME NOT NULL
        )
        ''')
        self.conn.commit()

    def get_article_content(self, url):
        """
        获取文章内容
        参数：
            url: 文章URL
        返回：
            article_data: 包含文章信息的字典
        """
        try:
            # 添加随机延迟，避免频繁请求
            time.sleep(random.uniform(1, 3))
            
            response = requests.get(url, headers=self.headers)
            response.raise_for_status()
            soup = BeautifulSoup(response.text, 'html.parser')
            
            # 提取文章信息
            title = soup.find('h1', class_='Post-Title').text.strip()
            content = soup.find('div', class_='Post-RichText').text.strip()
            
            # 获取点赞数
            vote_button = soup.find('button', class_='VoteButton--up')
            upvotes = int(re.search(r'\d+', vote_button.text).group()) if vote_button else 0
            
            return {
                'title': title,
                'url': url,
                'content': content,
                'upvotes': upvotes,
                'created_time': datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            }
            
        except Exception as e:
            print(f"获取文章失败: {url}")
            print(f"错误信息: {str(e)}")
            return None

    def classify_article(self, content):
        """
        对文章进行分类
        参数：
            content: 文章内容
        返回：
            category: 分类结果
        """
        # 使用结巴分词
        words = jieba.cut(content)
        word_list = list(words)
        
        # 计算每个分类的匹配度
        category_scores = {}
        for category, keywords in self.categories.items():
            score = sum(1 for word in word_list if any(keyword in word for keyword in keywords))
            category_scores[category] = score
        
        # 返回得分最高的分类
        if category_scores:
            return max(category_scores.items(), key=lambda x: x[1])[0]
        return 'others'

    def save_article(self, article_data):
        """
        保存文章到数据库
        参数：
            article_data: 文章信息字典
        """
        try:
            cursor = self.conn.cursor()
            
            # 插入文章数据
            cursor.execute('''
            INSERT INTO articles (title, url, content, upvotes, category, created_time, collect_time)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (
                article_data['title'],
                article_data['url'],
                article_data['content'],
                article_data['upvotes'],
                article_data['category'],
                article_data['created_time'],
                datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            ))
            
            self.conn.commit()
            return True
        except sqlite3.IntegrityError:
            print(f"文章已存在: {article_data['url']}")
            return False
        except Exception as e:
            print(f"保存文章失败: {str(e)}")
            return False

    def get_hot_articles(self):
        """获取热门文章列表"""
        hot_url = f"{self.base_url}/hot"
        try:
            response = requests.get(hot_url, headers=self.headers)
            response.raise_for_status()
            soup = BeautifulSoup(response.text, 'html.parser')
            
            # 获取文章链接
            articles = soup.find_all('a', class_='HotItem-title')
            return [urljoin(self.base_url, article['href']) for article in articles]
        except Exception as e:
            print(f"获取热门文章列表失败: {str(e)}")
            return []

    def run(self):
        """
        运行爬虫主程序
        """
        print("开始爬取知乎文章...")
        
        while True:
            try:
                # 获取热门文章列表
                article_urls = self.get_hot_articles()
                
                for url in article_urls:
                    # 获取文章内容
                    article_data = self.get_article_content(url)
                    
                    if article_data and article_data['upvotes'] >= 10000:
                        # 对文章进行分类
                        article_data['category'] = self.classify_article(article_data['content'])
                        
                        # 保存文章
                        if self.save_article(article_data):
                            print(f"已保存文章: {article_data['title']} (赞同数: {article_data['upvotes']})")
                
                # 间隔一段时间后继续下一轮爬取
                print("等待下一轮爬取...")
                time.sleep(10)  #(300) 5分钟间隔
                
            except KeyboardInterrupt:
                print("\n程序已停止")
                break
            except Exception as e:
                print(f"发生错误: {str(e)}")
                time.sleep(60)  # 发生错误时等待1分钟后继续
                
        self.conn.close()

    def query_articles(self, category=None, min_upvotes=10000):
        """
        查询已保存的文章
        参数：
            category: 文章分类
            min_upvotes: 最小点赞数
        返回：
            articles: 文章列表
        """
        cursor = self.conn.cursor()
        
        if category:
            cursor.execute('''
            SELECT title, url, upvotes, category, created_time 
            FROM articles 
            WHERE category = ? AND upvotes >= ?
            ORDER BY upvotes DESC
            ''', (category, min_upvotes))
        else:
            cursor.execute('''
            SELECT title, url, upvotes, category, created_time 
            FROM articles 
            WHERE upvotes >= ?
            ORDER BY upvotes DESC
            ''', (min_upvotes,))
            
        return cursor.fetchall()
